# Backend configuration. Copy to .env — docker compose sets the container-specific values itself.
APP_NAME="Product Catalogue"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080,http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database: stores enquiries, queued jobs and cache. MySQL in compose / RDS in AWS.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalogue
DB_USERNAME=catalogue
DB_PASSWORD=

# Stateless API: no sessions needed.
SESSION_DRIVER=array

# Swap to "sqs" / "redis" in AWS — no code change.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mailpit locally (web inbox http://localhost:8025). In AWS: MAIL_MAILER=ses.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="catalogue@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Catalogue (see config/catalogue.php for the merchandising lists) ---
CATALOGUE_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
CATALOGUE_SOURCE_TIMEOUT=5
CATALOGUE_SOURCE_RETRIES=2
CATALOGUE_CACHE_TTL=600
CATALOGUE_STALE_TTL=86400
CATALOGUE_HOMEPAGE_LIMIT=5
CATALOGUE_TOP_RATED_LIMIT=3

SALES_INBOX_EMAIL=sales@example.test
ENQUIRY_RATE_LIMIT_PER_MINUTE=5

# Comma-separated proxy IPs (or *) whose X-Forwarded-For is trusted. Empty = none.
TRUSTED_PROXIES=
