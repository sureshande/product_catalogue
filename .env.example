# Optional overrides for docker compose — everything has a working default.
# Copy to .env to change. Never commit .env.

# Leave empty to generate a key per container at start-up.
APP_KEY=

# Local-only database password for the MySQL container.
DB_PASSWORD=catalogue

# Where enquiry emails go. Locally they are caught by Mailpit (http://localhost:8025).
SALES_INBOX_EMAIL=sales@example.test

FAKESTORE_BASE_URL=https://fakestoreapi.com
CATALOGUE_CACHE_TTL=600
CATALOGUE_HOMEPAGE_LIMIT=5
CATALOGUE_TOP_RATED_LIMIT=3
